---
interface Props {
  src: string
  title?: string
  width?: number
  height?: number
}

const { src, title, width, height } = Astro.props

// dev 専用の寸法取得は動的 import にして、本番ビルドのモジュールグラフから外す
const video = import.meta.env.DEV ? await (await import('../lib/image-size')).getDevVideo(src) : { src, width, height }
---

<figure>
  <video autoplay loop muted playsinline width={video.width} height={video.height}>
    <source src={video.src} data-original-src={src} type="video/mp4">
  </video>
  {title && <figcaption>{title}</figcaption>}
</figure>

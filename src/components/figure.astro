---
interface Props {
  src: string
  alt?: string
  width?: number
  height?: number
}

const { src, alt, width, height } = Astro.props

// dev 専用の寸法取得は動的 import にして、本番ビルドのモジュールグラフから外す
const img = import.meta.env.DEV ? await (await import('../lib/image-size')).getDevImage(src) : { src, width, height }
---

<figure>
  <img src={img.src} data-original-src={src} alt="" loading="lazy" decoding="async" width={img.width} height={img.height}>
  {alt && <figcaption><p set:html={alt} /></figcaption>}
</figure>

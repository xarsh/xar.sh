---
import { render } from 'astro:content'
import { readFileSync } from 'node:fs'
import BaseLayout from '../../layouts/base-layout.astro'
import { extractDescription } from '../../lib/description'
import { loadDevTool } from '../../lib/dev-tools'
import { getPosts } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      // 新しい順なので、添字が小さいほうが新しい記事
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null
    }
  }))
}

const { post, prev, next } = Astro.props
const { Content } = await render(post)
// 本文が画像・生 HTML のみで抽出できない記事はタイトルで代用する
const description = extractDescription(post.body ?? '') || post.data.title

const DevTools = await loadDevTool('dev-media-editor/dev-media-editor.astro')
const rawMarkdown = DevTools ? readFileSync(`content/post/${post.id}.mdoc`, 'utf-8') : ''
---

<BaseLayout title={post.data.title} description={description} thumbnail={post.data.thumbnail} type="article">
  <div class="post" data-pagefind-body>
    <div class="date" data-pagefind-ignore>
      <time>{post.data.date.toISOString().slice(0, 10)}</time>
    </div>
    <h1 class="title">{post.data.title}</h1>
    <div class="body"><Content /></div>
  </div>

  <nav class="sibling">
    <div class="prev">{prev && <a href={`/post/${prev.id}/`}>{prev.data.title}</a>}</div>
    <div class="next">{next && <a href={`/post/${next.id}/`}>{next.data.title}</a>}</div>
  </nav>

  {DevTools && <DevTools rawMarkdown={rawMarkdown} />}
</BaseLayout>
